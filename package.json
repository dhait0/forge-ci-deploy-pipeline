{
  "name": "forge-ci-deploy-pipeline",
  "private": true,
  "version": "0.1.0",
  "description": "A bilingual Jenkins, Docker, and Linux CI/CD pipeline demo for a mock TypeScript service.",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "dev": "tsx src/server.ts",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier . --check",
    "format:write": "prettier . --write",
    "test": "node --test test/*.test.mjs",
    "smoke": "bash scripts/smoke-test.sh",
    "rollback": "bash scripts/rollback.sh",
    "screenshots": "node scripts/capture-screenshots.mjs",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.15.21",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "prettier": "^3.5.3",
    "tsx": "^4.19.2",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.18.2"
  },
  "lint-staged": {
    "*.{ts,js,mjs,json,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}
